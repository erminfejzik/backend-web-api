{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ApplyMigrations": false,
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ], // "Serilog.Sinks.Seq"
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "app/logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "",
    "Port": "",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": ""
  }
}
